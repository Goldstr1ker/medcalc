{
  "name": "medcalc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Клинические калькуляторы и шкалы с разбором по клиническим рекомендациям. Офлайн, на русском.",
  "scripts": {
    "index": "node scripts/build-index.mjs",
    "predev": "npm run index",
    "dev": "vite",
    "prebuild": "npm run index && npm run check",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "validate": "node scripts/validate-calculators.mjs",
    "pretest": "npm run index",
    "test": "node --test",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@vite-pwa/assets-generator": "^1.0.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
