{
  "// зачем": [
    "Проект на обычном JS без сборки TypeScript. Типы нужны только чтобы",
    "проверять форму калькуляторов и утилит: tsc здесь ничего не компилирует",
    "(noEmit), а checkJs заставляет его проверять .js по JSDoc-аннотациям.",
    "Компоненты (.jsx) пока вне проверки — там JSX и DOM, это отдельный заход."
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,

    // Тела формул намеренно не типизируем: набор полей свой у каждого
    // калькулятора, и требование аннотировать каждую локальную переменную
    // внутри calculate() стоило бы дороже, чем ловит. Проверяем ФОРМУ
    // калькулятора — метаданные, схему полей, диапазоны, что вернул
    // calculate() — там и живут ошибки, которые молча ломают отрисовку.
    "noImplicitAny": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/calculators/**/*.js", "src/lib/**/*"]
}
